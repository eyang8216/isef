# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Python packaging (editable install artifacts)
*.egg-info/
build/
dist/

# Jupyter
.ipynb_checkpoints/

# LaTeX intermediates
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc
*.xdv

# Obsidian local UI state (keep notes, ignore machine-specific workspace)
.obsidian/workspace.json
.obsidian/workspace-mobile.json

# Secrets / local env
.env
.env.*
*.pem
*.key

# reasonix
.reasonix/

# Agent skills (installed locally per machine, not versioned)
.agents/skills/
.claude/skills/

# agent-generated review reports (one-off artifacts, not source)
architecture-review-*.html
